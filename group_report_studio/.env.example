# Use a read-only account. No index or document writes are performed.
GR_OPENSEARCH_URL=http://localhost:9200
GR_OPENSEARCH_INDEX=weekly_mail
GR_OPENSEARCH_USER=
GR_OPENSEARCH_PASSWORD=
GR_OPENSEARCH_VERIFY_TLS=true
# Empty if week/type/mail_type are keyword fields; .keyword for text + keyword subfield.
GR_OPENSEARCH_KEYWORD_SUFFIX=

# Set the approved company model server. Base URL must include its API version prefix.
GR_LLM_BASE_URL=
GR_LLM_API_KEY=
GR_LLM_MODEL=

# Conservative UTF-8 input byte ceiling includes prompts and JSON schema.
# Leave additional model context for the requested output token count.
GR_MAX_INPUT_BYTES=40000
GR_SOURCE_CHUNK_BYTES=10000
GR_MAX_OUTPUT_TOKENS=6000
