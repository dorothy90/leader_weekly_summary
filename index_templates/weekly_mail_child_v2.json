{
  "settings": {
    "index": {"knn": true},
    "analysis": {
      "tokenizer": {"nori_tokenizer": {"type": "nori_tokenizer", "decompound_mode": "mixed"}},
      "analyzer": {"korean": {"type": "custom", "tokenizer": "nori_tokenizer", "filter": ["nori_readingform", "lowercase"]}}
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "child_id": {"type": "keyword"},
      "parent_id": {"type": "keyword"},
      "mail_id": {"type": "keyword"},
      "content_id": {"type": "keyword"},
      "document_locator": {"type": "keyword"},
      "user_id": {"type": "keyword"},
      "team": {"type": "keyword"},
      "week": {"type": "keyword"},
      "mail_type": {"type": "keyword"},
      "parser_version": {"type": "keyword"},
      "chunker_version": {"type": "keyword"},
      "embedding_model": {"type": "keyword"},
      "content_hash": {"type": "keyword"},
      "text": {"type": "text", "analyzer": "korean", "search_analyzer": "korean"},
      "embedding": {"type": "knn_vector", "dimension": 4096, "method": {"name": "hnsw", "space_type": "cosinesimil", "engine": "faiss", "parameters": {"ef_construction": 128, "m": 16}}},
      "section_ordinal": {"type": "integer"},
      "part_index": {"type": "integer"},
      "total_parts": {"type": "integer"},
      "indexed_at": {"type": "date"}
    }
  }
}
